{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(npm publish:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(gh pr merge:*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)"
    ],
    "allow": [
      "Bash(python scripts/harness/verify.py:*)",
      "Bash(python scripts/harness/check_traceability.py:*)",
      "Bash(python scripts/harness/sdd_status.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"$CLAUDE_PROJECT_DIR/scripts/harness/agent_hooks.py\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"$CLAUDE_PROJECT_DIR/scripts/harness/agent_hooks.py\" pre-tool",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet \"$CLAUDE_PROJECT_DIR/scripts/harness/agent_hooks.py\" stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
